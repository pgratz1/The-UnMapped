[gd_scene format=3]

[node name="Viewer" type="ViewerScreen"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Split" type="HSplitContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Sidebar" type="VBoxContainer" parent="Split"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2

[node name="OpenButton" type="Button" parent="Split/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
text = "Open world..."

[node name="FileLabel" type="Label" parent="Split/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
text = "No world open"
autowrap_mode = 1

[node name="LayersHeading" type="Label" parent="Split/Sidebar"]
layout_mode = 2
text = "Views"

[node name="LayerList" type="ItemList" parent="Split/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="MarkersHeading" type="Label" parent="Split/Sidebar"]
layout_mode = 2
text = "Markers"

[node name="MarkersToggle" type="CheckButton" parent="Split/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Settlements, ruins, event places and passes of the year (M)"
button_pressed = true
text = "Show markers"

[node name="MarkerBoxes" type="HBoxContainer" parent="Split/Sidebar"]
layout_mode = 2

[node name="MarkFaded" type="CheckBox" parent="Split/Sidebar/MarkerBoxes"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Faded ruins"

[node name="MarkEvents" type="CheckBox" parent="Split/Sidebar/MarkerBoxes"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
button_pressed = true
text = "Event places"

[node name="MarkPasses" type="CheckBox" parent="Split/Sidebar/MarkerBoxes"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
button_pressed = true
text = "Passes"

[node name="MarkerLegend" type="ItemList" parent="Split/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
auto_height = true
max_columns = 2
same_column_width = true
fixed_icon_size = Vector2i(23, 23)

[node name="MetaHeading" type="Label" parent="Split/Sidebar"]
layout_mode = 2
text = "Meta"

[node name="MetaTree" type="Tree" parent="Split/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 0.35
columns = 2
column_titles_visible = true
hide_root = true
select_mode = 1

[node name="MapArea" type="VBoxContainer" parent="Split"]
layout_mode = 2
size_flags_horizontal = 3

[node name="MapRow" type="HBoxContainer" parent="Split/MapArea"]
layout_mode = 2
size_flags_vertical = 3

[node name="MapView" type="LayerMapView" parent="Split/MapArea/MapRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(256, 256)
texture_filter = 1
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
focus_mode = 0

[node name="LegendPanel" type="VBoxContainer" parent="Split/MapArea/MapRow"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2

[node name="LegendTitle" type="Label" parent="Split/MapArea/MapRow/LegendPanel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
mouse_filter = 1
text = "Legend"
autowrap_mode = 3

[node name="LegendList" type="ItemList" parent="Split/MapArea/MapRow/LegendPanel"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
fixed_icon_size = Vector2i(40, 14)

[node name="YearBar" type="VBoxContainer" parent="Split/MapArea"]
layout_mode = 2

[node name="YearRow" type="HBoxContainer" parent="Split/MapArea/YearBar"]
layout_mode = 2

[node name="YearBack25" type="Button" parent="Split/MapArea/YearBar/YearRow"]
